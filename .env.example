# Database
DATABASE_URL="postgresql://user:password@localhost:5432/record_ai?schema=public"

# Auth
JWT_SECRET="your-jwt-secret"

# Email (OTP / password reset)
GMAIL_USER=""
GMAIL_PASS=""

# Azure Storage (recordings)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER="recordings"
# Optional: for SAS URLs (e.g. for Speech to read). If not set, parsed from connection string.
# AZURE_STORAGE_ACCOUNT_NAME=""
# AZURE_STORAGE_ACCOUNT_KEY=""
# AZURE_STORAGE_SAS_READ_DAYS=7

# Transcription: "azure" | "whisper" | "wispr" | "groq"
# TRANSCRIPTION_PROVIDER=groq

# Azure Speech (transcription with diarization) – used when TRANSCRIPTION_PROVIDER=azure or unset with keys present
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"

# Wisprflow.ai (https://wisprflow.ai) – used when TRANSCRIPTION_PROVIDER=wispr
# WISPR_API_KEY="your-api-key"
# WISPR_LANGUAGE=en

# Groq (free tier, OpenAI-compatible Whisper) – used when TRANSCRIPTION_PROVIDER=groq
# Get key: https://console.groq.com
# GROQ_API_KEY="gsk_xxx"

# Whisper (self-hosted or any OpenAI-compatible API) – used when TRANSCRIPTION_PROVIDER=whisper
# WHISPER_API_URL="http://localhost:9000"
# WHISPER_RESPONSE_FORMAT=verbose_json
# WHISPER_MODEL=whisper-1

# Server
PORT=3000
