generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                 @id @default(cuid())
  name                   String
  email                  String                 @unique
  password               String?                // null for Google-only users
  googleId               String?                @unique // Google OAuth sub
  isVerified             Boolean                @default(false)
  otp                    String?
  otpExpiry              DateTime?
  companyId              String?                // null = individual user
  companyRole            String?                // 'admin' | 'employee' when companyId is set
  createdAt              DateTime               @default(now())
  Information            Information[]
  Summary                Summary[]
  Task                   Task[]
  Transcript             Transcript[]
  Note                   Note[]
  Chat                   Chat[]
  TranscriptShares       TranscriptShare[]     @relation("SharedWithMe")
  company                Company?               @relation("CompanyMember", fields: [companyId], references: [id], onDelete: SetNull)
  companyAdmin           Company?              @relation("CompanyAdmin")
  meetingsCreated        Meeting[]              @relation("MeetingCreator")
  meetingParticipations  MeetingParticipant[]
  companyInvitesSent     CompanyInvite[]        @relation("InvitedBy")

  @@index([companyId])
}

model Chat {
  id        String        @id @default(cuid())
  title     String
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String   // 'user' | 'assistant'
  content   String   @db.Text
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([chatId])
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([userId])
}

model Conversation {
  id           String     @id @default(cuid())
  speaker      String
  text         String     @db.Text
  transcriptId String
  Transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
}

model Information {
  id        String   @id @default(cuid())
  text      String   @db.Text
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Summary {
  id        String   @id
  title     String
  content   String
  label     String
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model Task {
  id          String   @id
  heading     String
  description String
  date        DateTime
  label       String
  completed   Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id])
}

model Transcript {
  id           String            @id @default(cuid())
  recordingUrl String?
  status       String            @default("processing") // processing | completed | failed
  userId       String
  meetingId    String?           @unique
  createdAt    DateTime          @default(now())
  Conversation Conversation[]
  User         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  Shares       TranscriptShare[]
  meeting      Meeting?          @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([meetingId])
}

model TranscriptShare {
  id           String     @id @default(cuid())
  transcriptId String
  sharedWithId String
  createdAt    DateTime   @default(now())
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  sharedWith   User       @relation("SharedWithMe", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, sharedWithId])
  @@index([sharedWithId])
  @@index([transcriptId])
}

model Company {
  id          String         @id @default(cuid())
  name        String
  adminUserId String         @unique
  createdAt   DateTime       @default(now())
  admin       User           @relation("CompanyAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  members     User[]         @relation("CompanyMember")
  meetings    Meeting[]
  invites     CompanyInvite[]

  @@index([adminUserId])
}

model CompanyInvite {
  id          String   @id @default(cuid())
  companyId   String
  email       String
  invitedById String
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
  @@index([token])
}

model Meeting {
  id           String     @id @default(cuid())
  companyId    String
  createdById  String
  transcriptId String?    @unique
  createdAt    DateTime   @default(now())
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User       @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  transcript   Transcript?
  participants MeetingParticipant[]

  @@index([companyId])
  @@index([createdById])
  @@index([transcriptId])
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  createdAt DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}
