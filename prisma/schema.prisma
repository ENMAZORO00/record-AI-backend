generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String        @id @default(cuid())
  name        String
  email       String        @unique
  password    String?       // null for Google-only users
  googleId    String?       @unique // Google OAuth sub
  isVerified  Boolean       @default(false)
  otp         String?
  otpExpiry   DateTime?
  createdAt   DateTime      @default(now())
  Information Information[]
  Summary     Summary[]
  Task        Task[]
  Transcript  Transcript[]
  Note        Note[]
  Chat        Chat[]
}

model Chat {
  id        String        @id @default(cuid())
  title     String
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([updatedAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String   // 'user' | 'assistant'
  content   String   @db.Text
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([chatId])
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([userId])
}

model Conversation {
  id           String     @id @default(cuid())
  speaker      String
  text         String     @db.Text
  transcriptId String
  Transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
}

model Information {
  id        String   @id @default(cuid())
  text      String   @db.Text
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Summary {
  id        String   @id
  title     String
  content   String
  label     String
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model Task {
  id          String   @id
  heading     String
  description String
  date        DateTime
  label       String
  completed   Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id])
}

model Transcript {
  id           String         @id @default(cuid())
  recordingUrl String?
  status       String         @default("processing") // processing | completed | failed
  userId       String
  createdAt    DateTime       @default(now())
  Conversation Conversation[]
  User         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
